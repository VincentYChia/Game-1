; Game-1 — Godot 4 (.NET) migration target.
; See ../Godot-Migration/MIGRATION_PLAN.md for the plan and
; ../Godot-Migration/ARCHITECTURE_DECISIONS.md for the ADRs.

config_version=5

[application]

config/name="Game-1"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "C#")

[display]

; Scale the whole UI to the window so menus/HUD aren't tiny on high-res
; displays. 2D/Control layer renders at a 1920x1080 base then stretches;
; the 3D view is unaffected (renders at native resolution).
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Game1.Godot"

[rendering]

renderer/rendering_method="forward_plus"
